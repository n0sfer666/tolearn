{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tolearn",
  "mainBinaryName": "tolearn-desktop",
  "version": "0.1.0",
  "identifier": "dev.tolearn.app",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:4321",
    "beforeDevCommand": "pnpm -C ui dev",
    "beforeBuildCommand": "pnpm -C ui build"
  },
  "app": {
    "windows": [
      {
        "title": "tolearn",
        "width": 1100,
        "height": 760,
        "dragDropEnabled": true,
        "label": "main"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "tolearn"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "msi",
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "entitlements.plist"
    }
  }
}
