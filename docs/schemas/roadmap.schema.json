{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/n0sfer666/tolearn/blob/master/docs/schemas/roadmap.schema.json",
  "title": "learning-roadmap/v1",
  "description": "Шапка программы обучения: roadmap.yaml в корне бандла.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "title",
    "subject",
    "goal",
    "generated_at",
    "generated_by",
    "locale",
    "weekly_hours",
    "env_constraints",
    "version_pins",
    "calibration",
    "defaults",
    "stages",
    "topics"
  ],
  "properties": {
    "schema": { "const": "learning-roadmap/v1" },
    "id": { "$ref": "#/$defs/slug" },
    "title": { "$ref": "#/$defs/line" },
    "subject": { "$ref": "#/$defs/text" },
    "goal": { "$ref": "#/$defs/text" },
    "generated_at": { "type": "string", "format": "date" },
    "generated_by": { "$ref": "#/$defs/line" },
    "locale": { "type": "string", "pattern": "^[a-z]{2}(-[A-Za-z0-9]+)*$" },
    "weekly_hours": { "type": "integer", "minimum": 1 },
    "env_constraints": {
      "type": "array",
      "items": { "$ref": "#/$defs/text" }
    },
    "version_pins": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/pin_name" },
      "additionalProperties": { "$ref": "#/$defs/line" }
    },
    "calibration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "probed", "passed_out", "interrupted"],
      "properties": {
        "method": { "enum": ["diagnostic-probe", "self-report", "none"] },
        "probed": { "type": "integer", "minimum": 0 },
        "passed_out": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/slug" }
        },
        "interrupted": { "type": "boolean" }
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revalidate_after_days"],
      "properties": {
        "revalidate_after_days": {
          "type": "object",
          "additionalProperties": false,
          "required": ["stable", "evolving", "volatile"],
          "properties": {
            "stable": { "$ref": "#/$defs/days" },
            "evolving": { "$ref": "#/$defs/days" },
            "volatile": { "$ref": "#/$defs/days" }
          }
        }
      }
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["n", "title", "generated", "checkpoint"],
        "properties": {
          "n": { "type": "integer", "minimum": 1 },
          "title": { "$ref": "#/$defs/line" },
          "generated": { "type": "boolean" },
          "checkpoint": { "$ref": "#/$defs/slug" }
        }
      }
    },
    "topics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "stage", "file", "est_hours", "priority"],
        "properties": {
          "id": { "$ref": "#/$defs/slug" },
          "title": { "$ref": "#/$defs/line" },
          "stage": { "type": "integer", "minimum": 1 },
          "file": {
            "type": "string",
            "pattern": "^topics/[a-z0-9]+(-[a-z0-9]+)*\\.yaml$"
          },
          "est_hours": { "$ref": "#/$defs/hours" },
          "priority": { "enum": ["core", "recommended", "optional"] }
        }
      }
    }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "pin_name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "line": { "type": "string", "minLength": 1, "maxLength": 200 },
    "text": { "type": "string", "minLength": 1 },
    "days": { "type": "integer", "minimum": 1 },
    "hours": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "type": "integer", "minimum": 1 }
    }
  }
}
