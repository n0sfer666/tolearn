{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/n0sfer666/tolearn/blob/master/docs/schemas/topic.schema.json",
  "title": "learning-roadmap/topic/v1",
  "description": "Тема программы: topics/<id>.yaml внутри бандла.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "title",
    "stage",
    "depends_on",
    "est_hours",
    "volatility",
    "revalidate_after_days",
    "verified_at",
    "confidence",
    "retention",
    "version_context",
    "outcomes",
    "misconceptions",
    "materials",
    "practice",
    "questions",
    "exam"
  ],
  "properties": {
    "schema": { "const": "learning-roadmap/topic/v1" },
    "id": { "$ref": "#/$defs/slug" },
    "title": { "$ref": "#/$defs/line" },
    "stage": { "type": "integer", "minimum": 1 },
    "depends_on": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/slug" }
    },
    "est_hours": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "type": "integer", "minimum": 1 }
    },
    "volatility": { "enum": ["stable", "evolving", "volatile"] },
    "revalidate_after_days": { "type": "integer", "minimum": 1 },
    "verified_at": { "type": "string", "format": "date" },
    "confidence": { "enum": ["high", "medium", "low"] },
    "retention": { "enum": ["by_use", "by_schedule", "none"] },
    "version_context": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/pin_name" }
    },
    "outcomes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/text" }
    },
    "misconceptions": {
      "type": "array",
      "items": { "$ref": "#/$defs/text" }
    },
    "materials": {
      "type": "array",
      "items": { "$ref": "#/$defs/material" }
    },
    "practice": { "$ref": "#/$defs/practice" },
    "questions": {
      "type": "array",
      "items": { "$ref": "#/$defs/question" }
    },
    "exam": { "$ref": "#/$defs/exam" }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "pin_name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "line": { "type": "string", "minLength": 1, "maxLength": 200 },
    "text": { "type": "string", "minLength": 1 },
    "nullable_text": { "type": ["string", "null"], "minLength": 1 },
    "material": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "url",
        "type",
        "tier",
        "lang",
        "liveness",
        "published",
        "covers_version",
        "checked_at",
        "stale",
        "delta",
        "note"
      ],
      "properties": {
        "title": { "$ref": "#/$defs/line" },
        "url": { "type": "string", "format": "uri" },
        "type": {
          "enum": [
            "docs",
            "article",
            "post",
            "guide",
            "spec",
            "rfc",
            "repo",
            "video",
            "paper"
          ]
        },
        "tier": { "enum": ["T1", "T2", "T3"] },
        "lang": { "type": "string", "pattern": "^[a-z]{2}$" },
        "liveness": { "enum": ["ok", "paywall", "login_required"] },
        "published": {
          "type": ["string", "null"],
          "pattern": "^[0-9]{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12][0-9]|3[01]))?)?$"
        },
        "covers_version": { "$ref": "#/$defs/nullable_text" },
        "checked_at": { "type": "string", "format": "date" },
        "stale": { "type": "boolean" },
        "delta": { "$ref": "#/$defs/nullable_text" },
        "note": { "$ref": "#/$defs/text" }
      }
    },
    "practice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "tier",
        "task",
        "deliverable",
        "starting_point",
        "fallback",
        "time_box_min",
        "smoke_checked",
        "constraints",
        "acceptance"
      ],
      "properties": {
        "kind": { "enum": ["code", "ops", "analysis"] },
        "tier": { "enum": ["P1", "P2", "P3"] },
        "task": { "$ref": "#/$defs/text" },
        "deliverable": { "$ref": "#/$defs/text" },
        "starting_point": { "$ref": "#/$defs/nullable_text" },
        "fallback": { "$ref": "#/$defs/nullable_text" },
        "time_box_min": { "type": "integer", "minimum": 1 },
        "smoke_checked": { "type": "boolean" },
        "constraints": {
          "type": "array",
          "items": { "$ref": "#/$defs/check" }
        },
        "acceptance": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/check" }
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "claim", "check", "expect"],
      "properties": {
        "id": { "$ref": "#/$defs/check_id" },
        "claim": { "$ref": "#/$defs/text" },
        "check": { "$ref": "#/$defs/text" },
        "expect": { "$ref": "#/$defs/text" }
      }
    },
    "check_id": { "type": "string", "pattern": "^[ac][0-9]+$" },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "text", "expected_signals", "red_flags", "follow_up"],
      "properties": {
        "id": { "type": "string", "pattern": "^q[0-9]+$" },
        "type": {
          "enum": ["misconception", "diagnose", "boundary", "predict", "tradeoff"]
        },
        "text": { "$ref": "#/$defs/text" },
        "expected_signals": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/text" }
        },
        "red_flags": {
          "type": "array",
          "items": { "$ref": "#/$defs/text" }
        },
        "follow_up": { "$ref": "#/$defs/nullable_text" }
      }
    },
    "exam": {
      "type": "object",
      "additionalProperties": false,
      "required": ["focus", "traps", "artifact_required", "max_exchanges"],
      "properties": {
        "focus": { "$ref": "#/$defs/text" },
        "traps": {
          "type": "array",
          "items": { "$ref": "#/$defs/text" }
        },
        "artifact_required": { "type": "boolean" },
        "max_exchanges": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
