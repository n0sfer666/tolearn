---
import { type Locale, strings } from "../i18n";
import { THEMES } from "./themes.ts";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const text = strings(locale);
---

<nav aria-label={text.theme.switch}>
  {
    THEMES.map((choice) => (
      <button type="button" data-theme-choice={choice} aria-pressed="false">
        {text.theme[choice]}
      </button>
    ))
  }
</nav>

<script is:inline>
  const buttons = document.querySelectorAll("[data-theme-choice]");

  function mark(theme) {
    buttons.forEach((button) => {
      button.setAttribute("aria-pressed", String(button.dataset.themeChoice === theme));
    });
  }

  const stored = localStorage.getItem("tolearn.theme");
  mark(stored === "light" || stored === "dark" ? stored : "system");

  buttons.forEach((button) => {
    button.addEventListener("click", () => {
      const theme = button.dataset.themeChoice;
      if (theme === "light" || theme === "dark") {
        localStorage.setItem("tolearn.theme", theme);
        document.documentElement.dataset.theme = theme;
      } else {
        localStorage.removeItem("tolearn.theme");
        delete document.documentElement.dataset.theme;
      }
      mark(theme);
    });
  });
</script>

<style>
  nav {
    display: flex;
    gap: var(--spacing-1);
  }

  button {
    padding: var(--spacing-1) var(--spacing-3);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-bg-raised);
    color: var(--color-fg-muted);
    font-size: var(--font-size-sm);
  }

  button[aria-pressed="true"] {
    border-color: var(--color-border-strong);
    color: var(--color-fg);
  }
</style>
