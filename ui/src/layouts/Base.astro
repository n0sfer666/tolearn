---
import "@design/tokens.css";
import "../styles/base.css";

import EarlyTheme from "../components/EarlyTheme.astro";
import Keyboard from "../components/Keyboard.astro";
import RememberLocale from "../components/RememberLocale.astro";
import ThemeSwitch from "../components/ThemeSwitch.astro";
import { LOCALES, type Locale, localized, strings } from "../i18n";

interface Props {
  locale: Locale;
  title: string;
  back?: { href: string; text: string };
}

const { locale, title, back } = Astro.props;
const text = strings(locale);
const here = Astro.url.pathname;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — {text.app}</title>
    <EarlyTheme />
  </head>
  <body>
    <header>
      {back && <a href={localized(back.href, locale)} data-back>{back.text}</a>}
      <h1>{title}</h1>
      <nav aria-label={text.language.switch}>
        {
          LOCALES.map((other) => (
            <a href={localized(here, other)} data-locale={other} hreflang={other} lang={other}>
              {text.language[other]}
            </a>
          ))
        }
      </nav>
      <ThemeSwitch locale={locale} />
      <a href={localized("/queue/", locale)} data-queue>{text.nav.queue}</a>
    <a href={localized("/search/", locale)} data-search>{text.nav.search}</a>
      <a href={localized("/settings/", locale)} data-settings>{text.nav.settings}</a>
    </header>
    <main>
      <slot />
    </main>
    <RememberLocale />
    <Keyboard />
  </body>
</html>
