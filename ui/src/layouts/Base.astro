---
import icon from "@design/icon.svg?url";

import "@design/tokens.css";
import "../styles/fonts.css";
import "../styles/base.css";
import "../styles/layout.css";
import "../styles/controls.css";
import "../styles/switches.css";
import "../styles/content.css";
import "../styles/cards.css";
import "../styles/library.css";
import "../styles/status.css";
import "../styles/generate.css";
import "../styles/hint.css";
import "../styles/rich.css";
import "../styles/reading.css";
import "../styles/toast.css";
import "../styles/actions.css";

import Actions from "../components/Actions";
import Toasts from "../components/Toasts";
import EarlyTheme from "../components/EarlyTheme.astro";
import Header from "../components/Header.astro";
import KeepContext from "../components/KeepContext.astro";
import Names from "../components/Names.astro";
import Keyboard from "../components/Keyboard.astro";
import RememberLocale from "../components/RememberLocale.astro";
import { type Locale, strings } from "../i18n";

interface Props {
  locale: Locale;
  title: string;
  back?: { href: string; text: string } | undefined;
  folded?: boolean | undefined;
}

const { locale, title, back, folded } = Astro.props;
const text = strings(locale);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={icon} />
    <title>{title} — {text.app}</title>
    <EarlyTheme />
  </head>
  <body>
    <Header locale={locale} title={title} back={back} folded={folded}>
      <slot name="action" slot="action" />
    </Header>
    <main class="page">
      <slot />
    </main>
    <Toasts client:load close={text.toast.close} />
    <Actions client:load text={text.actions} />
    <RememberLocale />
    <KeepContext />
    <Names />
    <Keyboard />
  </body>
</html>
