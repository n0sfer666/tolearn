---
import { LOCALES, localeOf, strings } from "../../../i18n";
import Base from "../../../layouts/Base.astro";

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const locale = localeOf(Astro.params.locale);
const text = strings(locale);
---

<Base locale={locale} title={text.nav.exam} back={{ href: "/topic/", text: text.nav.topic }}>
  <section id="prompt">
    <h2>{text.exam.prompt}</h2>
    <p>{text.exam.promptLead}</p>
  </section>
  <section id="verdict">
    <h2>{text.exam.verdict}</h2>
    <p>{text.exam.verdictLead}</p>
  </section>
</Base>
