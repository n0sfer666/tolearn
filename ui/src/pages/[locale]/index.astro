---
import { LOCALES, localeOf, localized, strings } from "../../i18n";
import Programs from "../../islands/Programs";
import Base from "../../layouts/Base.astro";

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const locale = localeOf(Astro.params.locale);
const text = strings(locale);
---

<Base locale={locale} title={text.nav.library}>
  <a slot="action" href={localized("/new/", locale)} data-new data-action>{text.nav.new}</a>
  <div id="programs">
    <Programs text={text.programs} locale={locale} client:load />
  </div>
</Base>
