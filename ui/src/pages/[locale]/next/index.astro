---
import { LOCALES, localeOf, strings } from "../../../i18n";
import Next from "../../../islands/Next";
import Base from "../../../layouts/Base.astro";

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const locale = localeOf(Astro.params.locale);
const text = strings(locale);
---

<Base locale={locale} title={text.nav.next} back={{ href: "/stage/", text: text.nav.stage }}>
  <section id="next" aria-label={text.nav.next}>
    <Next client:load text={text} locale={locale} />
  </section>
</Base>
