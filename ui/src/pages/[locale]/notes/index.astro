---
import { LOCALES, localeOf, strings } from "../../../i18n";
import Base from "../../../layouts/Base.astro";
import Notes from "../../../islands/Notes";

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const locale = localeOf(Astro.params.locale);
const text = strings(locale);
---

<Base locale={locale} title={text.topic.notes} back={{ href: "/topic/", text: text.nav.topic }}>
  <section id="notes">
    <h2>{text.topic.notes}</h2>
    <p>{text.notes.lead}</p>
    <Notes text={text} locale={locale} client:load />
  </section>
</Base>
