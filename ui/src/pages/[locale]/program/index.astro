---
import { LOCALES, localeOf, strings } from "../../../i18n";
import Program from "../../../islands/Program";
import ProgramMenu from "../../../islands/ProgramMenu";
import Base from "../../../layouts/Base.astro";

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const locale = localeOf(Astro.params.locale);
const text = strings(locale);
---

<Base locale={locale} title={text.nav.program} back={{ href: "/", text: text.nav.library }}>
  <ProgramMenu slot="action" client:load text={text} />
  <section id="program" aria-label={text.nav.program}>
    <Program client:load text={text} locale={locale} />
  </section>
</Base>
