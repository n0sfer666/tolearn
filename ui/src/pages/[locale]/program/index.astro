---
import StatusGlyph from "../../../components/StatusGlyph.astro";
import { STATUSES } from "../../../components/status";
import { LOCALES, localeOf, plural, strings } from "../../../i18n";
import Base from "../../../layouts/Base.astro";

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const locale = localeOf(Astro.params.locale);
const text = strings(locale);
const statuses = STATUSES;
---

<Base locale={locale} title={text.nav.program} back={{ href: "/", text: text.nav.programs }}>
  <section id="stages">
    <h2>{text.program.stages}</h2>
    <p>{text.program.lead}</p>
    <p id="tally">{plural(locale, statuses.length, text.counts.topics)}</p>
    <ul>
      {
        statuses.map((status) => (
          <li>
            <StatusGlyph status={status} label={text.status[status]} />
            {text.status[status]}
          </li>
        ))
      }
    </ul>
  </section>
</Base>
