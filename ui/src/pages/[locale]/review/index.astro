---
import { LOCALES, localeOf, strings } from "../../../i18n";
import Base from "../../../layouts/Base.astro";
import Review from "../../../islands/Review";

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const locale = localeOf(Astro.params.locale);
const text = strings(locale);
---

<Base locale={locale} title={text.nav.review} back={{ href: "/topic/", text: text.nav.topic }}>
  <section id="gaps">
    <h2>{text.review.gaps}</h2>
    <p>{text.review.gapsLead}</p>
    <Review text={text} client:load />
  </section>
</Base>
