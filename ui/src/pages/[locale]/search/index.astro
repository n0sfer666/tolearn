---
import { LOCALES, localeOf, strings } from "../../../i18n";
import Base from "../../../layouts/Base.astro";
import Search from "../../../islands/Search";

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const locale = localeOf(Astro.params.locale);
const text = strings(locale);
---

<Base locale={locale} title={text.nav.search} back={{ href: "/program/", text: text.nav.program }}>
  <section id="search">
    <p>{text.search.lead}</p>
    <Search text={text} locale={locale} client:load />
  </section>
</Base>
