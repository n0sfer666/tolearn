---
import { LOCALES, localeOf, strings } from "../../../i18n";
import Base from "../../../layouts/Base.astro";
import Settings from "../../../islands/Settings";
import Provider from "../../../islands/Provider";
import Encryption from "../../../islands/Encryption";

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const locale = localeOf(Astro.params.locale);
const text = strings(locale);
---

<Base locale={locale} title={text.nav.settings} back={{ href: "/", text: text.nav.programs }}>
  <p>{text.settings.lead}</p>
  <section class="grid" aria-label={text.nav.settings}>
    <Settings text={text} locale={locale} client:load />
    <Provider text={text} locale={locale} client:load />
    <Encryption text={text} client:load />
  </section>
</Base>
