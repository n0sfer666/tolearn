---
import { LOCALES, localeOf, strings } from "../../../i18n";
import Base from "../../../layouts/Base.astro";
import Ledger from "../../../islands/Ledger";
import Settings from "../../../islands/Settings";
import Provider from "../../../islands/Provider";

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const locale = localeOf(Astro.params.locale);
const text = strings(locale);
---

<Base locale={locale} title={text.nav.settings} back={{ href: "/", text: text.nav.library }}>
  <p>{text.settings.lead}</p>
  <section data-studio data-settings aria-label={text.nav.settings}>
    <div data-studio-ask>
      <Provider text={text} locale={locale} client:load />
    </div>
    <div data-studio-side>
      <Ledger text={text} client:load />
      <Settings text={text} locale={locale} client:load />
    </div>
  </section>
</Base>
