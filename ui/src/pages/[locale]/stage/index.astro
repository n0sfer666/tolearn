---
import { LOCALES, localeOf, strings } from "../../../i18n";
import Stage from "../../../islands/Stage";
import Base from "../../../layouts/Base.astro";

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const locale = localeOf(Astro.params.locale);
const text = strings(locale);
---

<Base locale={locale} title={text.nav.stage} back={{ href: "/program/", text: text.nav.program }}>
  <section id="stage" aria-label={text.nav.stage}>
    <Stage client:load text={text} locale={locale} />
  </section>
</Base>
