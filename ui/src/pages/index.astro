---
import "@design/tokens.css";
import "../styles/base.css";

import EarlyTheme from "../components/EarlyTheme.astro";
import RememberLocale from "../components/RememberLocale.astro";
import ThemeSwitch from "../components/ThemeSwitch.astro";
import { LOCALES, strings } from "../i18n";
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>tolearn</title>
    <EarlyTheme />
    <script is:inline>
      const stored = localStorage.getItem("tolearn.locale");
      const known = ["ru", "en"];
      const wanted = known.includes(stored) ? stored : navigator.language.slice(0, 2);
      location.replace(`/${known.includes(wanted) ? wanted : "ru"}/`);
    </script>
  </head>
  <body>
    <header>
      <h1>tolearn</h1>
      <ThemeSwitch locale="ru" />
    </header>
    <main>
      <section id="language">
        <h2>{strings("ru").language.switch}</h2>
        <ul>
          {
            LOCALES.map((locale) => (
              <li>
                <a href={`/${locale}/`} data-locale={locale} hreflang={locale} lang={locale}>
                  {strings(locale).language[locale]}
                </a>
              </li>
            ))
          }
        </ul>
      </section>
    </main>
    <RememberLocale />
  </body>
</html>
