---
import StatusGlyph from "../../components/StatusGlyph.astro";
import { GLYPHS, type Status } from "../../components/status";
import Base from "../../layouts/Base.astro";

const statuses = Object.keys(GLYPHS) as Status[];
---

<Base title="Программа" back={{ href: "/", text: "Программы" }}>
  <section id="stages">
    <h2>Этапы</h2>
    <p>Лента этапов с темами и чекпойнтами.</p>
    <ul>
      {
        statuses.map((status) => (
          <li>
            <StatusGlyph status={status} label={status} />
            {status}
          </li>
        ))
      }
    </ul>
  </section>
</Base>
