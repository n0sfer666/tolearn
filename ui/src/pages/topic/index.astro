---
import Base from "../../layouts/Base.astro";
import Acceptance from "../../islands/Acceptance";

const sections = [
  ["outcomes", "Результаты"],
  ["misconceptions", "Заблуждения"],
  ["materials", "Материалы"],
  ["practice", "Практика"],
  ["questions", "Вопросы"],
  ["exam", "Зачёт"],
  ["notes", "Конспект"],
];
---

<Base title="Тема" back={{ href: "/program/", text: "Программа" }}>
  {
    sections.map(([id, title]) => (
      <section id={id}>
        <h2>{title}</h2>
        {id === "practice" && <Acceptance client:load items={[]} />}
      </section>
    ))
  }
</Base>
